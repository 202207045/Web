<script>
    $(document).ready(function() {
        const sname = sessionStorage.getItem("sname");
        const scode = sessionStorage.getItem("scode");
        
        if (sname) {
            $(".before").hide();
            $(".after").show();
            $(".sname").html(`${sname}(${scode})`);
        } else {
            $(".before").show();
            $(".after").hide();
        }

        // 로그아웃 클릭 이벤트
        $(".logout").on("click", function(e){
            e.preventDefault();
            if(confirm("정말로 로그아웃할래?")){
                sessionStorage.clear();
                location.href = '/';
            }
        });
    });
</script>
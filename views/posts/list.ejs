<div class="my-5">
    <h1 class="text-center mb-5">게시글 목록</h1>
    <div class="text-end mb-2">
        <button class="btn btn-primary btn-insert">글쓰기</button>
    </div>
    
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th width="10%">ID</th>
                <th width="40%">제목</th>
                <th width="25%">작성자</th>
                <th width="25%">날짜</th>
            </tr>
        </thead>
        <tbody id="list-body"></tbody>
    </table>

    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
</div>

<script id="temp" type="text/x-handlebars-template">
    {{#each list}}
    <tr>
        <td>{{ID}}</td>
        <td><a href="/posts/{{ID}}">{{TITLE}}</a></td>
        <td>{{SNAME}}({{WRITER}})</td>
        <td class="text-end">{{FMT_DATE}}</td>
    </tr>
    {{/each}}
</script>

<script>
    let page = 1;
    let size = 5;
    getList();

    // 글쓰기 버튼 이벤트
    $(".btn-insert").on("click", function(){
        const scode = sessionStorage.getItem("scode");
        if(scode){
            location.href = '/posts/insert';
        } else {
            alert("로그인이 필요합니다.");
            sessionStorage.setItem("target", "/posts/insert");
            location.href = '/users/login';
        }
    });

    $("#next").on("click", function(){ page++; getList(); });
    $("#prev").on("click", function(){ page--; getList(); });

    function getList(){
        $.ajax({
            type: "get",
            url: "/posts/list.json",
            data: { page, size },
            success: function(data) {
                // data.list를 템플릿에 전달
                const template = Handlebars.compile($("#temp").html());
                $("#list-body").html(template(data)); 
                
                const last = Math.ceil(data.total / size);
                $("#page").html(`${page}/${last}`);
                $("#prev").attr("disabled", page == 1);
                $("#next").attr("disabled", page == last);
            }
        });
    }
</script>